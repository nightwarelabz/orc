{
  "policies": {
    "Preferences": {
      "webgl.disabled": {
        "Value": false,
        "Status": "user"
      },
      "media.eme.enabled": {
        "Value": true,
        "Status": "user"
      }
    },
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableFeedbackCommands": true,
    "DisableFirefoxAccounts": false,
    "DontCheckDefaultBrowser": true,
    "NoDefaultBookmarks": false,
    "OverrideFirstRunPage": "https://nosuchmachine.net/",
    "OverridePostUpdatePage": "https://nosuchmachine.net/",
    "Homepage": {
      "URL": "https://nosuchmachine.net/",
      "StartPage": "homepage"
    },
    "NewTabPage": true,
    "FirefoxHome": {
      "Search": true,
      "TopSites": false,
      "SponsoredTopSites": false,
      "Pocket": false,
      "SponsoredPocket": false,
      "Highlights": false,
      "Snippets": false
    },
    "UserMessaging": {
      "WhatsNew": false,
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true,
      "MoreFromMozilla": false
    },
    "SearchSuggestEnabled": false,
    "DisableFormHistory": true,
    "HttpsOnlyMode": "enabled",
    "Cookies": {
      "Default": "AcceptThirdParty: from-visited",
      "RejectTracker": true,
      "Locked": false
    },
    "EnableTrackingProtection": {
      "Value": true,
      "Locked": false,
      "Cryptomining": true,
      "Fingerprinting": true,
      "EmailTracking": true
    },
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "default_area": "navbar"
      }
    },
    "SearchEngines": {
      "Default": "Tractor",
      "Add": [
        {
          "Name": "Tractor",
          "URLTemplate": "http://127.0.0.1:45873/search?q={searchTerms}",
          "IconURL": "http://127.0.0.1:45873/assets/icon.svg"
        }
      ],
      "PreventInstalls": false,
      "Remove": [
        "Google",
        "Bing",
        "Amazon.com",
        "eBay"
      ]
    },
    "Bookmarks": [
      {
        "Title": "Blacksite OS",
        "URL": "https://nosuchmachine.net/",
        "Folder": "toolbar"
      },
      {
        "Title": "Blacksite Bench",
        "URL": "https://nosuchmachine.net/bench/",
        "Folder": "toolbar"
      }
    ],
    "DNSOverHTTPS": {
      "Enabled": true,
      "Locked": false,
      "Fallback": true
    },
    "PasswordManagerEnabled": true,
    "OfferToSaveLoginsDefault": true,
    "SanitizeOnShutdown": {
      "Cache": true,
      "Cookies": false,
      "Downloads": false,
      "FormData": true,
      "History": false,
      "Sessions": false,
      "SiteSettings": false,
      "OfflineApps": true,
      "Locked": false
    }
  }
}
